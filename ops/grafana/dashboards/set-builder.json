    {
      "type": "timeseries",
      "title": "Requests per second by endpoint",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "setbuilder-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 8
