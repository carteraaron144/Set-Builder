{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd server && JAVA_HOME=/opt/homebrew/opt/openjdk@21 ./gradlew bootRun -PskipWeb -q"
      ],
      "port": 8080
    }
  ]
}
